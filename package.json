{
  "name": "zoorvan-majoon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "test:integration": "playwright test --config playwright.integration.config.js",
    "format": "prettier --write src tests prisma/seed.js",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "formik": "^2.4.6",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yup": "^1.6.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "nodemailer": "$nodemailer"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
